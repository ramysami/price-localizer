{
  "manifest_version": 3,
  "name": "Price Localizer",
  "version": "1.0.0",
  "description": "Converts prices on any web page into your currency (EGP by default) using up-to-date exchange rates, highlighted in green.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Price Localizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://latest.currency-api.pages.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
